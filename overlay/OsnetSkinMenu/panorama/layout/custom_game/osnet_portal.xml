          <Button id="op-command-7" class="op-command-row op-hidden">
            <Label class="op-label" text="{s:command_7_name}" />
            <Label class="op-copy" text="{s:command_7_description}" />
            <Label class="op-command-example" text="{s:command_7_example}" />
          </Button>
        </Panel>
        <Panel id="op-settings" class="op-view only-settings">
          <Label class="op-title" text="{s:settings_title}" />
          <Label class="op-copy" text="{s:settings_subtitle}" />
          <Panel class="op-setting-row">
            <Panel class="op-setting-text">
              <Label class="op-card-title" text="{s:setting_hint_title}" />
              <Label class="op-copy" text="{s:setting_hint_description}" />
            </Panel>
            <Button id="op-setting-hint" class="op-toggle">
              <Label class="op-label" text="{s:setting_hint_value}" />
            </Button>
          </Panel>
          <Panel class="op-setting-row">
            <Panel class="op-setting-text">
              <Label class="op-card-title" text="{s:setting_hold_title}" />
              <Label class="op-copy" text="{s:setting_hold_description}" />
            </Panel>
            <Button id="op-setting-hold" class="op-toggle">
              <Label class="op-label" text="{s:setting_hold_value}" />
            </Button>
          </Panel>
          <Panel class="op-setting-row">
            <Panel class="op-setting-text">
              <Label class="op-card-title" text="{s:setting_join_title}" />
              <Label class="op-copy" text="{s:setting_join_description}" />
            </Panel>
            <Button id="op-setting-join" class="op-toggle">
              <Label class="op-label" text="{s:setting_join_value}" />
            </Button>
          </Panel>
          <Panel class="op-setting-row">
            <Panel class="op-setting-text">
              <Label class="op-card-title" text="{s:setting_delay_title}" />
              <Label class="op-copy" text="{s:setting_delay_description}" />
            </Panel>
            <Panel class="op-stepper">
              <Button id="op-delay-minus" class="op-button">
                <Label class="op-label" text="{s:minus}" />
              </Button>
              <Label class="op-step-value" text="{s:setting_delay_value}" />
              <Button id="op-delay-plus" class="op-button">
                <Label class="op-label" text="{s:plus}" />
              </Button>
            </Panel>
          </Panel>
          <Label class="op-muted" text="{s:settings_saved}" />
        </Panel>
      </Panel>
      <Panel class="op-footer">
        <Label class="op-muted" text="{s:footer_hint}" />
        <Panel id="op-pager" class="op-pager op-hidden">
          <Button id="op-prev" class="op-button">
            <Label class="op-label" text="{s:prev}" />
          </Button>
          <Label class="op-muted" text="{s:page_label}" />
          <Button id="op-next" class="op-button">
            <Label class="op-label" text="{s:next}" />
          </Button>
        </Panel>
        <Label class="op-footer-brand" text="{s:footer_brand}" />
      </Panel>
    </Panel>
  </Panel>
</root>